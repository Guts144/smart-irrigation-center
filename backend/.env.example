# Copy to backend/.env — loaded automatically by run-dev.sh
#
# Gmail/Google SMTP requires an App Password (16 chars), NOT your normal password:
#   1. Enable 2-Step Verification on your Google account
#   2. Create App Password: https://myaccount.google.com/apppasswords
#   3. Paste it below as MAIL_PASSWORD

MAIL_PASSWORD=your-16-char-app-password-here

# SMTP account used to send (usually same as your Google mailbox)
MAIL_USERNAME=mohamed.gharsalli@etudiant-ipeiem.utm.tn

# Where contact form messages are delivered
MAIL_TO=mohamed.gharsalli@etudiant-ipeiem.utm.tn
MAIL_FROM=mohamed.gharsalli@etudiant-ipeiem.utm.tn

MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
