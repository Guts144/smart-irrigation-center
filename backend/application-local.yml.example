# Copy to application-local.yml (gitignored) and fill in your SMTP credentials.
#
# Gmail/Google (your @etudiant-ipeiem.utm.tn uses Google SMTP):
#   host: smtp.gmail.com, port: 587
#   You MUST use a Gmail App Password — normal password will NOT work.
#   Create one: https://myaccount.google.com/apppasswords
#   Put it in backend/.env as:  MAIL_PASSWORD=xxxx xxxx xxxx xxxx
#
# Then start with:  ./run-dev.sh

spring:
  mail:
    host: smtp.gmail.com
    port: 587
    username: mohamed.gharsalli@etudiant-ipeiem.utm.tn
    password: ${MAIL_PASSWORD:}

aquasense:
  mail:
    enabled: true
    to: mohamed.gharsalli@etudiant-ipeiem.utm.tn
    from: mohamed.gharsalli@etudiant-ipeiem.utm.tn
