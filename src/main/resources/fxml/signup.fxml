<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartirrigation.controller.SignupController" styleClass="root">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="📝 Create Account" styleClass="header-label"/>
    
    <VBox spacing="15" alignment="CENTER" styleClass="card" maxWidth="400">
        <TextField fx:id="usernameField" promptText="Choose Username"/>
        <PasswordField fx:id="passwordField" promptText="Choose Password"/>
        
        <CheckBox fx:id="adminCheckBox" text="Create Admin Account"/>
        <PasswordField fx:id="adminCodeField" promptText="Enter Admin Code" visible="false" managed="false"/>
        
        <Button text="Sign Up" onAction="#handleSignup" maxWidth="Infinity"/>
        <Button text="Back to Login" onAction="#handleBackToLogin" styleClass="button-link"/>
        
        <Label fx:id="errorLabel"/>
    </VBox>
</VBox>
