<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartirrigation.controller.LoginController" styleClass="root">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="🌿 Smart Irrigation System" styleClass="header-label"/>
    
    <VBox spacing="15" alignment="CENTER" styleClass="card" maxWidth="400">
        <Label text="🔐 User Login" styleClass="sub-header-label"/>
        
        <TextField fx:id="usernameField" promptText="Username"/>
        <PasswordField fx:id="passwordField" promptText="Password"/>
        
        <HBox spacing="15" alignment="CENTER">
            <Button text="Login" onAction="#handleLogin"/>
            <Button text="Sign Up" onAction="#handleGoToSignup" styleClass="button-secondary"/>
        </HBox>
        
        <Label fx:id="errorLabel" textFill="red"/>
    </VBox>
</VBox>
